# ---------------------------------------------------------------
# Template for your private settings.
# Copy this file to a new file called .env and fill in the values.
# The .env file is never uploaded to GitHub (see .gitignore).
# ---------------------------------------------------------------

# AWS: the region where your S3 bucket was created, for example ap-south-1 (Mumbai)
AWS_REGION=replace_me

# AWS: access key of the IAM user tesla-telemetry-etl
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# AWS: name of the S3 bucket that holds the raw telemetry files
S3_BUCKET=replace_me

# Snowflake: account identifier with a dash (Snowsight: click your name > Account > View account details), for example ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=replace_me

# Snowflake: your login name, for example STUDENT1
SNOWFLAKE_USER=replace_me
